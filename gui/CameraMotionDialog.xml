              <Bitmap profile="cameraMotionChangedMarker" name="changedMarker" visible="false"/>
            </Text>
          </Bitmap>
          <Bitmap profile="cameraMotionSliderContainer" name="idleSwayContainer" visible="false">
            <OptionSlider profile="cameraMotionOptionSlider" name="idleSway" onClick="onSliderChanged">
              <ThreePartBitmap profile="cameraMotionOptionSliderBg" name="ignore">
                <ThreePartBitmap profile="cameraMotionOutlineBg"/>
              </ThreePartBitmap>
            </OptionSlider>
            <Text profile="cameraMotionSettingTitle" name="settingTitle" text="$l10n_cameraMotion_idleSway">
              <Bitmap profile="cameraMotionChangedMarker" name="changedMarker" visible="false"/>
            </Text>
          </Bitmap>
          <Bitmap profile="cameraMotionToggleContainer" name="idleWhileMovingContainer" visible="false">
            <BinaryOption profile="cameraMotionBinaryOption" name="idleWhileMoving" useYesNoTexts="true" onClick="onToggleChanged"/>
