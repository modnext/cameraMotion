              <Bitmap profile="cameraMotionChangedMarker" name="changedMarker" visible="false"/>
            </Text>
          </Bitmap>
        </ScrollingLayout>

        <GuiElement profile="cameraMotionSettingConnectionContainer" name="idleSwayConnectionContainer" onDraw="onDrawIdleSwayConnection" visible="false">
