          <Bitmap profile="cameraMotionSettingConnection" name="idleSwayConnectionBottom" size="6px 1dp"/>
        </GuiElement>

        <Bitmap profile="cameraMotionStopClipper"/>
        <ThreePartBitmap profile="fs25_subCategoryListSliderBox" position="20px 0px">
          <Slider profile="fs25_listSlider" dataElementId="playerThirdPersonLayout"/>
        </ThreePartBitmap>
      </GuiElement>

      <!-- Global Settings Page -->
      <BoxLayout profile="cameraMotionSettingsPage" id="globalSettingsPage" visible="false">
        <Bitmap profile="cameraMotionToggleContainer">
          <BinaryOption profile="cameraMotionBinaryOption" id="advancedMode" onClick="onAdvancedModeChanged"/>
          <Text profile="cameraMotionSettingTitle" name="settingTitle" text="$l10n_cameraMotion_advancedMode">
            <Bitmap profile="cameraMotionChangedMarker" name="changedMarker" visible="false"/>
          </Text>
        </Bitmap>
        <Bitmap profile="cameraMotionToggleContainer">
          <Button profile="cameraMotionSettingsButton" id="resetAllButton" text="$l10n_cameraMotion_resetAll" onClick="onClickResetAll">
            <ThreePartBitmap profile="fs25_settingsButtonBg"/>
          </Button>
          <Text profile="cameraMotionSettingTitle" text="$l10n_cameraMotion_resetAll"/>
        </Bitmap>
      </BoxLayout>
    </GuiElement>

    <!-- Footer Buttons -->
    <BoxLayout profile="cameraMotionButtonBox" id="buttonsBox">
      <Button profile="buttonActivate" id="globalSettingsButton" text="$l10n_cameraMotion_globalSettings" onClick="onClickGlobalSettings"/>
      <Button profile="buttonDelete" id="resetButton" text="$l10n_cameraMotion_resetProfile" onClick="onClickReset"/>
      <Button profile="buttonBack" id="backButton" text="$l10n_button_back" onClick="onClickBack"/>
    </BoxLayout>
